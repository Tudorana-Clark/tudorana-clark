# Public site settings baked into the web build (safe to commit; nothing here is secret).
SITE_URL=https://www.tudoranaclark.com
PORTRAIT_URL=https://sttudoranaclarkgfkywk.blob.core.windows.net/media/brand/portrait-94a3bf8fcb6c.jpg
STAGE_PHOTO_URL=https://sttudoranaclarkgfkywk.blob.core.windows.net/media/brand/stage-72f8deb7f7bc.jpg
# Google Tag Manager container (public pages only; GA4 is configured inside GTM). Empty = no tracking.
GTM_ID=GTM-WLTS7ZNX
# Keep one replica of each app running so visitors never wait for a cold start.
# Idle-rate cost after the free grant: web ≈ $14/month, API ≈ $8/month. Set to 0 to scale to zero again.
WEB_MIN_REPLICAS=1
API_MIN_REPLICAS=1
