ENVIRONMENT=local
# "memory" runs fully offline; "cosmos" uses Azure (az login)
STORAGE_BACKEND=cosmos
ADMIN_API_KEY=change-me-long-random
SITE_URL=http://localhost:3000
COSMOS_ENDPOINT=https://<cosmos-account>.documents.azure.com:443/
STORAGE_ACCOUNT=<storage-account>
MEDIA_BASE_URL=https://<storage-account>.blob.core.windows.net/media
OPENAI_ENDPOINT=https://<openai-account>.openai.azure.com/
OPENAI_DEPLOYMENT=gpt-4.1-mini
# Foundry resource for AI covers (MAI image model). Empty uses offline placeholder images.
IMAGE_ENDPOINT=https://<foundry-resource>.services.ai.azure.com
IMAGE_DEPLOYMENT=MAI-Image-2.6-Flash
# Claude on the same Foundry resource drafts and fact-checks articles. Empty keeps them on OPENAI_DEPLOYMENT.
CLAUDE_RESOURCE=<foundry-resource-name>
CLAUDE_DEPLOYMENT=claude-opus-5-5
INDEXNOW_KEY=<32-hex-chars>
# Resend (send-only key). Empty disables email notifications.
RESEND_API_KEY=
NOTIFY_EMAIL=daniel@tudoranaclark.com
